{
  "name": "betterpip",
  "private": true,
  "version": "0.0.1",
  "description": "One floating Picture-in-Picture window with the video and its tools, for Firefox and Zen.",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@lucide/svelte": "1.70.0",
    "@tailwindcss/vite": "4.3.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "bits-ui": "2.20.6",
    "clsx": "2.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
